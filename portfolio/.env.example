# GitHub Personal Access Token (PAT)
# Required for fetching real contribution calendar activity via GitHub GraphQL API.
# Generate one at: https://github.com/settings/tokens
# Scopes required: `read:user` (or fine-grained Personal Access Token with read access to user profile)
#
# IMPORTANT: Never commit actual tokens to source control.
# Copy this file to `.env.local` and add your real token there:
# cp .env.example .env.local

GITHUB_TOKEN=your_github_personal_access_token_here

